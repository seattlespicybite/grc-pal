# Copy to .env for docker compose or local runs. Every setting is documented in docs/configuration.md.

# --- local trial -------------------------------------------------------------
GRCPAL_DEMO=1                       # sample users, cycles and evidence (empty database only)
# GRCPAL_BASE=/program              # your program repository (catalog/, registers/, policies/)

# --- email -------------------------------------------------------------------
GRCPAL_MAIL_BACKEND=console         # console | smtp | graph | off
GRCPAL_MAIL_FROM=grc-pal@localhost
# With the mailpit profile:
# GRCPAL_MAIL_BACKEND=smtp
# GRCPAL_SMTP_HOST=mailpit
# GRCPAL_SMTP_PORT=1025
# GRCPAL_SMTP_TLS=none

# --- production (set by deploy/azure/deploy.sh; shown for reference) --------
# GRCPAL_ENV=production
# GRCPAL_AUTH_MODE=easyauth
# GRCPAL_SECRET=<openssl rand -hex 32>
# GRCPAL_TENANT=acme
# GRCPAL_PUBLIC_URL=https://grc.acme.example
# GRCPAL_TABLES_URL=https://<account>.table.core.windows.net
# GRCPAL_EVIDENCE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# GRCPAL_BOOTSTRAP_ADMINS=you@acme.example
# GRCPAL_ALLOWED_TENANT_IDS=<your Entra directory ID>
