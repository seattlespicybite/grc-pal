#!/usr/bin/env python3
"""Stand-in for the Azure CLI in tests of deploy/azure/check.py and kit.sh: answers from FAKE_STATE (JSON)."""
import json, os, sys
st = json.load(open(os.environ["FAKE_STATE"]))
a = sys.argv[1:]
with open(os.environ["FAKE_LOG"], "a") as log:
    log.write(json.dumps(a) + "\n")
def opt(name):
    return a[a.index(name) + 1] if name in a else None
if a[:2] == ["containerapp", "show"]:
    if not st.get("app"):
        sys.exit(3)
    q = opt("--query") or ""
    print(st["app"]["properties"]["configuration"]["ingress"]["fqdn"] if "fqdn" in q else json.dumps(st["app"]))
elif a[:3] == ["containerapp", "revision", "list"]:
    print(json.dumps(st["revisions"]))
elif a[:3] == ["containerapp", "auth", "show"]:
    print(json.dumps(st["auth"]))
elif a[:3] == ["containerapp", "secret", "show"]:
    print(st["secrets"][opt("--secret-name")])
elif a[:3] == ["ad", "app", "list"]:
    print(json.dumps([x for x in st["apps"] if x["displayName"] == opt("--display-name")]))
elif a[:3] == ["ad", "app", "update"]:
    app = next(x for x in st["apps"] if x["appId"] == opt("--id"))
    app["web"]["redirectUris"] = [opt("--web-redirect-uris")]
    json.dump(st, open(os.environ["FAKE_STATE"], "w"))
elif a[:3] == ["ad", "sp", "show"]:
    print(json.dumps({"appRoleAssignmentRequired": st.get("assignment_required", True)}))
else:
    sys.exit(f"fake az: unexpected {' '.join(a)}")
