#!/usr/bin/env python3
"""Stand-in for curl in tests of deploy/azure/check.py: answers from FAKE_STATE["http"] by path."""
import json, os, sys
from urllib.parse import urlparse
st = json.load(open(os.environ["FAKE_STATE"]))
a = sys.argv[1:]
path = urlparse(a[-1]).path or "/"
if "-sI" in a:
    print(st.get("headers", "HTTP/2 200\r\ncontent-security-policy: default-src 'self'\r\nstrict-transport-security: max-age=1\r\n"))
    sys.exit(0)
queue = st["http"].get(path, ["000"])
answer = queue.pop(0) if len(queue) > 1 else queue[0]
json.dump(st, open(os.environ["FAKE_STATE"], "w"))
if path == "/" and not any(x.startswith("X-MS-CLIENT-PRINCIPAL: ") for x in a):
    sys.exit("fake curl: the forged-header probe must send X-MS-CLIENT-PRINCIPAL")
print(answer, end="")
