#!/usr/bin/env python3
"""Stand-in for the Azure CLI in tests of deploy/azure/update.sh: keeps a tiny model of one container app."""
import json, os, sys
state_path = os.environ["FAKE_STATE"]
st = json.load(open(state_path))
a = sys.argv[1:]
with open(os.environ["FAKE_LOG"], "a") as log:
    log.write(json.dumps(a) + "\n")
def opt(name, default=None):
    return a[a.index(name) + 1] if name in a else default
def save():
    json.dump(st, open(state_path, "w"))
def out(v):
    print(v)
cmd = " ".join(x for x in a[:4] if not x.startswith("-"))
q = opt("--query", "")
def values(flag):  # the words after a flag, up to the next flag
    if flag not in a:
        return []
    rest = a[a.index(flag) + 1:]
    return rest[:next((i for i, x in enumerate(rest) if x.startswith("-")), len(rest))]
env = st.setdefault("env", {"GRCPAL_AUTH_MODE": "easyauth"})
JOB_TEMPLATE = {"containers": [{"name": "backup", "image": "old", "command": ["grcpal"], "args": ["backup", "scheduled"],
                               "resources": {"cpu": 0.5, "memory": "1Gi"},
                               "env": [{"name": "GRCPAL_TABLES_URL", "value": "https://st.table.core.windows.net/"},
                                       {"name": "GRCPAL_TENANT", "value": "acme"},
                                       {"name": "GRCPAL_SETTINGS_KEY", "secretRef": "settings-key"}]}]}
if a[:2] == ["containerapp", "show"]:
    if "GRCPAL_AUTH_MODE" in q: out(env.get("GRCPAL_AUTH_MODE", ""))
    elif "ingress.fqdn" in q: out("app.example.com")
    elif q == "id": out("/subscriptions/s/resourceGroups/rg/providers/Microsoft.App/containerApps/app")
    # the app's template: after a failed update it names the new image while traffic stays on the old revision
    elif "image" in q: out(st.get("template_image") or st["revisions"][st["serving"]]["image"])
    elif "latestReadyRevisionName" in q: out(st["serving"])
elif a[:2] == ["tag", "list"]:
    key = q.split('"')[1]
    out(st["tags"].get(key, ""))
elif a[:2] == ["tag", "update"]:
    for kv in a[a.index("--tags") + 1:]:
        if "=" in kv and not kv.startswith("-"):
            k, v = kv.split("=", 1); st["tags"][k] = v
    save()
elif a[:4] == ["containerapp", "ingress", "traffic", "show"]:
    rows = [{"revisionName": st["serving"], "weight": 100}]
    rows += [{"revisionName": r, "weight": 0, "label": l} for l, r in st["labels"].items()]
    out(json.dumps(rows))
elif a[:4] == ["containerapp", "ingress", "traffic", "set"]:
    st["serving"] = opt("--revision-weight").split("=")[0]; save()
elif a[:3] == ["containerapp", "revision", "set-mode"]:
    pass
elif a[:2] == ["containerapp", "update"]:
    for kv in values("--set-env-vars"):
        k, v = kv.split("=", 1); env[k] = v
    for k in values("--remove-env-vars"):
        env.pop(k, None)
    name = "grcpal-acme--" + opt("--revision-suffix")
    st["revisions"][name] = {"image": opt("--image") or st["revisions"][st["serving"]]["image"], "active": True,
                             "env": dict(env)}; save()
elif a[:3] == ["containerapp", "auth", "update"]:
    st["easyauth"] = opt("--enabled") == "true"; save()
elif a[:3] == ["containerapp", "auth", "show"]:
    out(str(st.get("easyauth", True)).lower())
elif a[:2] == ["containerapp", "exec"]:
    st["exec"] = opt("--command"); save()
elif a[:3] == ["containerapp", "revision", "show"]:
    rev = opt("--revision")
    out("rev.example.com" if "fqdn" in q else st["revisions"][rev]["image"])
elif a[:4] == ["containerapp", "revision", "label", "add"]:
    st["labels"][opt("--label")] = opt("--revision"); save()
elif a[:3] == ["containerapp", "revision", "list"]:
    out("\n".join(r for r, v in st["revisions"].items() if v["active"]))
elif a[:3] == ["containerapp", "revision", "deactivate"]:
    st["revisions"][opt("--revision")]["active"] = False; save()
elif a[:3] == ["containerapp", "revision", "activate"]:
    st["revisions"][opt("--revision")]["active"] = True; save()
elif a[:3] == ["containerapp", "job", "show"]:
    out(json.dumps(JOB_TEMPLATE))
elif a[:3] == ["containerapp", "job", "start"]:
    if "--yaml" in a:   # the whole execution template, as Azure takes it
        c = next(c for c in json.load(open(opt("--yaml")))["containers"] if c["name"] == "backup")
        image, args, job_env = c["image"], c["args"], {e["name"]: e.get("value", e.get("secretRef")) for e in c.get("env", [])}
    else:               # Azure replaces the WHOLE template: --image/--command/--args alone drop the job's env vars
        image, args, job_env = opt("--image"), a[a.index("--args") + 1:a.index("--query")], {}
    st["executions"].append({"image": image, "args": args, "env": job_env}); save()
    out(f"exec-{len(st['executions'])}")
elif a[:4] == ["containerapp", "job", "execution", "show"]:
    ex = st["executions"][int(opt("--job-execution-name").split("-")[1]) - 1]
    fail = os.environ.get("FAKE_FAIL", "")
    out("Failed" if fail and " ".join(ex["args"]).startswith(fail) else "Succeeded")
elif a[:3] == ["containerapp", "job", "update"]:
    st["jobs"][opt("-n")] = opt("--image"); save()
else:
    sys.exit(f"fake az: unexpected command {cmd}")
