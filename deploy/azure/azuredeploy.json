    "smtpUser": {
      "type": "string",
      "defaultValue": ""
    },
    "smtpPassword": {
      "type": "securestring",
      "defaultValue": ""
    },
    "retentionDays": {
      "type": "int",
      "defaultValue": 730,
      "minValue": 1,
      "metadata": {
        "description": "Days each evidence file is write-protected. Cover the audit window plus at least one year."
      }
    },
    "storageSku": {
      "type": "string",
      "defaultValue": "Standard_GRS",
      "allowedValues": [
        "Standard_LRS",
        "Standard_ZRS",
        "Standard_GRS"
      ]
    },
