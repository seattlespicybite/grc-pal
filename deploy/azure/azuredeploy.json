        ],
        "cpu": "0.25",
        "memory": "0.5Gi"
      },
      {
        "name": "backup",
        "cron": "7 * * * *",
        "args": [
          "backup",
          "run-due"
        ],
        "cpu": "1.0",
        "memory": "2Gi"
      }
    ]
