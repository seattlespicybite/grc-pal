        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', format('cae-{0}', variables('appName')))]",
        "workloadProfileName": "Consumption",
        "configuration": {
          "triggerType": "Schedule",
          "replicaTimeout": 3600,
          "replicaRetryLimit": 1,
          "scheduleTriggerConfig": {
            "cronExpression": "[variables('jobs')[copyIndex()].cron]",
            "parallelism": 1,
            "replicaCompletionCount": 1
          },
          "secrets": "[if(variables('usePrivateRegistry'), concat(variables('baseSecrets'), createArray(createObject('name', 'registry-password', 'value', parameters('registryPassword')))), variables('baseSecrets'))]",
          "registries": "[if(variables('usePrivateRegistry'), createArray(createObject('server', parameters('registryServer'), 'username', parameters('registryUsername'), 'passwordSecretRef', 'registry-password')), createArray())]"
        },
        "template": {
          "containers": [
            {
              "name": "[variables('jobs')[copyIndex()].name]",
              "image": "[parameters('image')]",
              "command": [
                "grcpal"
              ],
              "args": "[variables('jobs')[copyIndex()].args]",
              "resources": {
                "cpu": "[json(variables('jobs')[copyIndex()].cpu)]",
                "memory": "[variables('jobs')[copyIndex()].memory]"
              },
              "env": [
                {
                  "name": "AZURE_CLIENT_ID",
                  "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', variables('appName'))), '2023-01-31').clientId]"
                },
                {
                  "name": "GRCPAL_ENV",
                  "value": "production"
                },
                {
                  "name": "GRCPAL_AUTH_MODE",
                  "value": "easyauth"
                },
                {
                  "name": "GRCPAL_TENANT",
                  "value": "[parameters('instanceName')]"
                },
                {
                  "name": "GRCPAL_SECRET",
                  "secretRef": "grcpal-secret"
                },
                {
                  "name": "GRCPAL_ENCRYPTION_KEY",
                  "secretRef": "encryption-key"
                },
                {
                  "name": "GRCPAL_PUBLIC_URL",
                  "value": "[format('https://{0}.{1}', variables('appName'), reference(resourceId('Microsoft.App/managedEnvironments', format('cae-{0}', variables('appName'))), '2024-03-01').defaultDomain)]"
                },
                {
                  "name": "GRCPAL_TABLES_URL",
                  "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), '2023-05-01').primaryEndpoints.table]"
                },
                {
                  "name": "GRCPAL_EVIDENCE_ACCOUNT_URL",
                  "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), '2023-05-01').primaryEndpoints.blob]"
                },
                {
                  "name": "GRCPAL_BOOTSTRAP_ADMINS",
                  "value": "[parameters('bootstrapAdmins')]"
                },
                {
                  "name": "GRCPAL_ALLOWED_TENANT_IDS",
                  "value": "[parameters('allowedTenantIds')]"
                },
                {
                  "name": "GRCPAL_MAIL_BACKEND",
                  "value": "[parameters('mailBackend')]"
                },
                {
                  "name": "GRCPAL_MAIL_FROM",
                  "value": "[parameters('mailFrom')]"
                },
                {
                  "name": "GRCPAL_SMTP_HOST",
                  "value": "[parameters('smtpHost')]"
                },
                {
                  "name": "GRCPAL_SMTP_PORT",
                  "value": "[parameters('smtpPort')]"
                },
                {
                  "name": "GRCPAL_SMTP_USER",
                  "value": "[parameters('smtpUser')]"
                },
                {
                  "name": "GRCPAL_SMTP_PASSWORD",
                  "secretRef": "smtp-password"
                },
                {
                  "name": "GRCPAL_BACKUP_KEY",
                  "secretRef": "backup-key"
                },
                {
                  "name": "GRCPAL_BACKUP_CONTAINER",
                  "value": "backups"
                }
              ]
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('cae-{0}', variables('appName')))]",
        "[extensionResourceId(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', variables('appName'))), variables('roleIds').blobContributor))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', variables('appName')))]",
        "[extensionResourceId(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), 'Microsoft.Authorization/roleAssignments', guid(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', variables('appName'))), variables('roleIds').tableContributor))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ]
    },
    {
      "condition": "[not(empty(parameters('githubRepo')))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.App/containerApps', variables('appName'))]",
      "name": "[guid(resourceId('Microsoft.App/containerApps', variables('appName')), 'updater', variables('roleIds').contributor)]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-updater', variables('appName'))), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roleIds').contributor)]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/containerApps', variables('appName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-updater', variables('appName')))]"
      ]
    },
    {
      "copy": {
        "name": "updaterOnJobs",
        "count": "[length(variables('jobs'))]"
      },
      "condition": "[not(empty(parameters('githubRepo')))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.App/jobs', take(format('job-{0}-{1}', replace(parameters('instanceName'), '_', '-'), variables('jobs')[copyIndex()].name), 32))]",
      "name": "[guid(resourceId('Microsoft.App/jobs', take(format('job-{0}-{1}', replace(parameters('instanceName'), '_', '-'), variables('jobs')[copyIndex()].name), 32)), 'updater', variables('roleIds').contributor)]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-updater', variables('appName'))), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('roleIds').contributor)]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/jobs', take(format('job-{0}-{1}', replace(parameters('instanceName'), '_', '-'), variables('jobs')[copyIndex()].name), 32))]",
        "[resourceId('Microsoft.App/jobs', take(format('job-{0}-{1}', replace(parameters('instanceName'), '_', '-'), variables('jobs')[copyIndex()].name), 32))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-updater', variables('appName')))]"
      ]
    },
    {
      "condition": "[not(empty(parameters('githubRepo')))]",
      "type": "Microsoft.Authorization/roleDefinitions",
      "apiVersion": "2022-04-01",
      "name": "[guid(resourceGroup().id, 'grcpal-updater-env-join')]",
      "properties": {
        "roleName": "[format('GRC-pal updater environment use ({0})', resourceGroup().name)]",
        "description": "Lets the GRC-pal updater create container app revisions in this environment, nothing else.",
        "type": "CustomRole",
        "permissions": [
          {
            "actions": [
              "Microsoft.App/managedEnvironments/read",
              "Microsoft.App/managedEnvironments/join/action"
            ]
          }
        ],
        "assignableScopes": [
          "[resourceGroup().id]"
        ]
      }
    },
    {
      "condition": "[not(empty(parameters('githubRepo')))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.App/managedEnvironments', format('cae-{0}', variables('appName')))]",
      "name": "[guid(resourceId('Microsoft.App/managedEnvironments', format('cae-{0}', variables('appName'))), 'updater', 'env-join')]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-updater', variables('appName'))), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[resourceId('Microsoft.Authorization/roleDefinitions', guid(resourceGroup().id, 'grcpal-updater-env-join'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('cae-{0}', variables('appName')))]",
        "[resourceId('Microsoft.Authorization/roleDefinitions', guid(resourceGroup().id, 'grcpal-updater-env-join'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-updater', variables('appName')))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps/authConfigs",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}/{1}', variables('appName'), 'current')]",
      "properties": {
        "platform": {
          "enabled": true
        },
        "globalValidation": {
          "unauthenticatedClientAction": "RedirectToLoginPage",
          "redirectToProvider": "azureactivedirectory",
          "excludedPaths": [
            "/healthz"
          ]
        },
        "httpSettings": {
          "requireHttps": true
        },
        "identityProviders": {
          "azureActiveDirectory": {
            "enabled": true,
            "registration": {
              "clientId": "[parameters('entraClientId')]",
              "clientSecretSettingName": "microsoft-provider-authentication-secret",
              "openIdIssuer": "[format('{0}{1}/v2.0', environment().authentication.loginEndpoint, variables('tenantId'))]"
            },
            "validation": {
              "allowedAudiences": [
                "[parameters('entraClientId')]",
                "[format('api://{0}', parameters('entraClientId'))]"
              ]
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/containerApps', variables('appName'))]"
      ]
    }
  ],
  "outputs": {
    "portalUrl": {
      "type": "string",
      "value": "[format('https://{0}.{1}', variables('appName'), reference(resourceId('Microsoft.App/managedEnvironments', format('cae-{0}', variables('appName'))), '2024-03-01').defaultDomain)]"
    },
    "redirectUri": {
      "type": "string",
      "value": "[format('{0}/.auth/login/aad/callback', format('https://{0}.{1}', variables('appName'), reference(resourceId('Microsoft.App/managedEnvironments', format('cae-{0}', variables('appName'))), '2024-03-01').defaultDomain))]"
    },
    "storageAccount": {
      "type": "string",
      "value": "[variables('storageName')]"
    },
    "evidenceAccountUrl": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), '2023-05-01').primaryEndpoints.blob]"
    },
    "tablesUrl": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', variables('storageName')), '2023-05-01').primaryEndpoints.table]"
    },
    "portalIdentityClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', variables('appName'))), '2023-01-31').clientId]"
    },
    "portalIdentityPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', variables('appName'))), '2023-01-31').principalId]"
    },
    "collectorClientId": {
      "type": "string",
      "value": "[if(empty(parameters('githubRepo')), '', reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-collector', variables('appName'))), '2023-01-31').clientId)]"
    },
    "updaterClientId": {
      "type": "string",
      "value": "[if(empty(parameters('githubRepo')), '', reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-updater', variables('appName'))), '2023-01-31').clientId)]"
    },
    "collectorPrincipalId": {
      "type": "string",
      "value": "[if(empty(parameters('githubRepo')), '', reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}-collector', variables('appName'))), '2023-01-31').principalId)]"
    }
  }
}